@model IEnumerable<CP4.Catalogo.Web.Models.ProdutoViewModel>

@{
    ViewData["Title"] = "Catálogo de Produtos";
    string currentProvider = ViewBag.SelectedProvider as string ?? "SqlServer";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Catálogo de Produtos</h1>
        <p class="text-muted mb-0">Os dados são obtidos da API REST.</p>
    </div>
    <a asp-action="Create" asp-route-provider="@currentProvider" class="btn btn-primary">Novo produto</a>
</div>

<div class="card mb-4 bg-light">
    <div class="card-body">
        <h2 class="h5 card-title">Provider de banco de dados</h2>
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-sm-auto">
                <label for="providerSelect" class="col-form-label">Banco ativo</label>
            </div>
            <div class="col-sm-4">
                <select id="providerSelect" name="provider" class="form-select" onchange="this.form.submit()">
                    @if (currentProvider == "Oracle")
                    {
                        <option value="SqlServer">SQL Server</option>
                        <option value="Oracle" selected>Oracle</option>
                    }
                    else
                    {
                        <option value="SqlServer" selected>SQL Server</option>
                        <option value="Oracle">Oracle</option>
                    }
                </select>
            </div>
            <div class="col-sm-auto">
                <span class="badge @(currentProvider == "Oracle" ? "bg-warning text-dark" : "bg-info") fs-6">
                    Provider enviado à API: @currentProvider
                </span>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nome</th>
                <th scope="col">Preço</th>
                <th scope="col">Estoque</th>
                <th scope="col">Categoria</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.Nome</strong></td>
                        <td>@item.Preco.ToString("C")</td>
                        <td>@item.QuantidadeEstoque unidades</td>
                        <td><span class="badge bg-secondary">@(item.NomeCategoria ?? "Sem categoria")</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" asp-route-provider="@currentProvider" class="btn btn-sm btn-outline-primary">Detalhes</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                        Nenhum produto cadastrado no provider <strong>@currentProvider</strong>.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

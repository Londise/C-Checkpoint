@model CP4.Catalogo.Web.Models.ProdutoCreateViewModel

@{
    ViewData["Title"] = "Cadastrar Produto";
    string currentProvider = ViewBag.SelectedProvider as string ?? "SqlServer";
}

<h1 class="h2">Cadastrar Produto</h1>
<p class="text-muted">Provider selecionado: <strong>@currentProvider</strong></p>

@if (!Model.Categorias.Any())
{
    <div class="alert alert-warning" role="alert">
        Não há categorias disponíveis. Execute o script do banco ou cadastre uma categoria pelo endpoint <code>POST /api/categorias</code> no Swagger.
    </div>
}

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form asp-action="Create" method="post">
            <input type="hidden" name="provider" value="@currentProvider" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome do produto</label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descricao" class="form-label">Descrição</label>
                <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Preco" class="form-label">Preço</label>
                    <input asp-for="Preco" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="Preco" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="QuantidadeEstoque" class="form-label">Estoque</label>
                    <input asp-for="QuantidadeEstoque" type="number" min="0" class="form-control" />
                    <span asp-validation-for="QuantidadeEstoque" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="CategoriaId" class="form-label">Categoria</label>
                <select asp-for="CategoriaId" class="form-select">
                    <option value="">Selecione uma categoria</option>
                    @foreach (var categoria in Model.Categorias)
                    {
                        <option value="@categoria.Id">@categoria.Nome</option>
                    }
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success" disabled="@(!Model.Categorias.Any())">Salvar produto</button>
            <a asp-action="Index" asp-route-provider="@currentProvider" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

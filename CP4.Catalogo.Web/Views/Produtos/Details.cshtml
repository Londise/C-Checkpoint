@model CP4.Catalogo.Web.Models.ProdutoViewModel

@{
    ViewData["Title"] = "Detalhes do Produto";
    string currentProvider = ViewBag.SelectedProvider as string ?? "SqlServer";
}

<h1 class="h2">Detalhes do Produto</h1>

<div class="card col-lg-8">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <span>Produto #@Model.Id</span>
        <span class="badge bg-info">Provider: @currentProvider</span>
    </div>
    <div class="card-body">
        <h2 class="h4 card-title">@Model.Nome</h2>
        <dl class="row mb-0">
            <dt class="col-sm-3">Descrição</dt>
            <dd class="col-sm-9">@(Model.Descricao ?? "Não informada")</dd>
            <dt class="col-sm-3">Preço</dt>
            <dd class="col-sm-9">@Model.Preco.ToString("C")</dd>
            <dt class="col-sm-3">Estoque</dt>
            <dd class="col-sm-9">@Model.QuantidadeEstoque unidades</dd>
            <dt class="col-sm-3">Categoria</dt>
            <dd class="col-sm-9">@(Model.NomeCategoria ?? "Não informada")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Index" asp-route-provider="@currentProvider" class="btn btn-outline-secondary">Voltar ao catálogo</a>
    </div>
</div>
